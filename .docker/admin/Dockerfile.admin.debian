ARG ADMIN_BASE="{{ admin_base_image }}"
FROM ${ADMIN_BASE}

RUN apt-get update && apt-get install -y --no-install-recommends \
    zsh tmux curl wget git eza fzf tree \
    zsh-syntax-highlighting zsh-autosuggestions \
    ca-certificates tzdata tar gzip unzip openssh-client nano \
    && rm -rf /var/lib/apt/lists/*

ARG USERNAME="human"
ARG HOME_DIR="/home/${USERNAME}"
ARG HOST_UID="1000"

RUN useradd -ms /bin/zsh -u ${HOST_UID} ${USERNAME}

USER ${USERNAME}
WORKDIR ${HOME_DIR}

ARG NVM_VERSION="0.39.7"
ARG NODE_VERSION="20.12.2"
ENV NVM_DIR="/usr/local/nvm"

USER root
RUN mkdir -p /usr/local/nvm && chown ${USERNAME}:${USERNAME} /usr/local/nvm
USER ${USERNAME}

RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v$NVM_VERSION/install.sh | bash && \
    . "$NVM_DIR/nvm.sh" && \
    nvm install $NODE_VERSION

ENV PATH="$NVM_DIR/versions/node/v$NODE_VERSION/bin:$PATH"

USER root
# Starship
RUN curl -sS https://starship.rs/install.sh | sh -s -- -y

# Gitmux
ARG GITMUX_VERSION="v0.11.5"
ARG GITMUX_SHA256="d46a10f5fe07ab5b8a902ac29c937e4d3c8d7f33ea30fa335d682601697b5a71"
RUN wget -q "https://github.com/arl/gitmux/releases/download/${GITMUX_VERSION}/gitmux_${GITMUX_VERSION}_linux_amd64.tar.gz" -O /tmp/gitmux.tar.gz && \
    echo "${GITMUX_SHA256}  /tmp/gitmux.tar.gz" | sha256sum -c - && \
    tar xzf /tmp/gitmux.tar.gz -C /usr/local/bin && \
    rm /tmp/gitmux.tar.gz

USER ${USERNAME}

# Zsh Completions — relocated to /usr/local/share/
USER root
RUN git clone https://github.com/zsh-users/zsh-completions.git /tmp/zc && \
    mkdir -p /usr/local/share/zsh-completions && \
    mv /tmp/zc/src/* /usr/local/share/zsh-completions/ && \
    rm -rf /tmp/zc

USER ${USERNAME}

# Tmux TPM & Catppuccin — relocated to /usr/local/tmux-plugins/
USER root
RUN mkdir -p /usr/local/tmux-plugins && chown ${USERNAME}:${USERNAME} /usr/local/tmux-plugins
USER ${USERNAME}
RUN git clone https://github.com/tmux-plugins/tpm /usr/local/tmux-plugins/tpm
RUN mkdir -p /usr/local/tmux-plugins/catppuccin && \
    git clone -b v2.1.3 https://github.com/catppuccin/tmux.git /usr/local/tmux-plugins/catppuccin/tmux

ENV SHELL=/bin/zsh
ENV EDITOR=/usr/bin/nano
ENV VISUAL=/usr/bin/nano

COPY --chown=root:root entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod a+x /usr/local/bin/entrypoint.sh

USER ${USERNAME}

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]