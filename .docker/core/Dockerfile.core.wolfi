# ─── Build Stage: base tools for downloading ──────────────────────────────────
ARG AGENT_BASE="{{ core_base_image }}"
FROM ${AGENT_BASE} AS base

USER root
RUN apk update && apk add --no-cache curl bash git wget unzip jq python3 py3-pip coreutils file gzip tzdata ca-certificates nano

ARG USERNAME="agent"
ARG HOME_DIR="/home/${USERNAME}"
ARG HOST_UID="1000"

RUN addgroup -g ${HOST_UID} ${USERNAME} && \
    adduser -D -u ${HOST_UID} -G ${USERNAME} -s /bin/bash -h ${HOME_DIR} ${USERNAME} && \
    chown -R ${USERNAME}:${USERNAME} ${HOME_DIR}

USER ${USERNAME}
WORKDIR ${HOME_DIR}

ARG NVM_VERSION="0.39.7"
ARG NODE_VERSION="20.12.2"
ENV NVM_DIR="/usr/local/nvm"

USER root
RUN mkdir -p /usr/local/nvm && chown ${USERNAME}:${USERNAME} /usr/local/nvm
USER ${USERNAME}

RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v$NVM_VERSION/install.sh | bash && \
    . "$NVM_DIR/nvm.sh" && \
    nvm install $NODE_VERSION

ENV PATH="$NVM_DIR/versions/node/v$NODE_VERSION/bin:$PATH"

# ─── Parallel Builder Stages ──────────────────────────────────────────────────

FROM base AS branch-rust
ARG ENABLE_RUST=true
USER root
RUN mkdir -p /staging/usr/local/bin
RUN if [ "$ENABLE_RUST" = "true" ]; then \
      curl -L https://github.com/rust-lang/rust-analyzer/releases/latest/download/rust-analyzer-x86_64-unknown-linux-gnu.gz | gunzip -c - > /staging/usr/local/bin/rust-analyzer && \
      chmod u+x /staging/usr/local/bin/rust-analyzer; \
    fi

FROM base AS branch-typescript
ARG ENABLE_TYPESCRIPT=true
USER ${USERNAME}
RUN mkdir -p /staging/usr/local/npm-ts
RUN if [ "$ENABLE_TYPESCRIPT" = "true" ]; then \
      npm install -g typescript-language-server typescript --prefix /staging/usr/local/npm-ts; \
    fi

FROM base AS branch-go
ARG ENABLE_GO=true
USER root
RUN mkdir -p /staging/usr/local/go && mkdir -p /staging/usr/local/go-workspace/bin
RUN if [ "$ENABLE_GO" = "true" ]; then \
      OS="$(uname -s | tr '[:upper:]' '[:lower:]')" && \
      ARCH="$(uname -m)" && \
      if [ "$ARCH" = "x86_64" ]; then ARCH="amd64"; fi && \
      if [ "$ARCH" = "aarch64" ]; then ARCH="arm64"; fi && \
      LATEST_VERSION=$(curl -s "https://go.dev/dl/?mode=json" | jq -r '.[0].version') && \
      TARBALL="${LATEST_VERSION}.${OS}-${ARCH}.tar.gz" && \
      DOWNLOAD_URL="https://go.dev/dl/${TARBALL}" && \
      TMP_DIR="$(mktemp -d)" && \
      TMP_FILE="${TMP_DIR}/${TARBALL}" && \
      curl -sL "${DOWNLOAD_URL}" -o "${TMP_FILE}" && \
      tar -C /staging/usr/local -xzf "${TMP_FILE}" && \
      export GOPATH=/staging/usr/local/go-workspace && \
      PATH=$PATH:/staging/usr/local/go/bin /staging/usr/local/go/bin/go install golang.org/x/tools/gopls@latest; \
    fi

FROM base AS branch-python
ARG ENABLE_PYTHON=true
USER root
RUN mkdir -p /staging/usr/local/bin
USER ${USERNAME}
RUN mkdir -p /staging/usr/local/npm-python
RUN if [ "$ENABLE_PYTHON" = "true" ]; then \
      curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/staging/usr/local/bin" sh && \
      npm install -g pyright --prefix /staging/usr/local/npm-python; \
    fi

FROM base AS branch-claude
USER ${USERNAME}
RUN mkdir -p /staging/usr/local/bin && \
    npm install -g @fission-ai/openspec@latest && \
    curl -fsSL https://claude.ai/install.sh | bash && \
    cp ${HOME_DIR}/.claude/local/claude /staging/usr/local/bin/claude

# ─── Runtime Stage: no curl, wget, unzip, socat ──────────────────────────────
FROM ${AGENT_BASE} AS runtime

USER root
RUN apk update && apk add --no-cache bash git jq python3 py3-pip openssh-server coreutils file gzip tzdata ca-certificates nano

ARG USERNAME="agent"
ARG HOME_DIR="/home/${USERNAME}"
ARG HOST_UID="1000"

RUN addgroup -g ${HOST_UID} ${USERNAME} && \
    adduser -D -u ${HOST_UID} -G ${USERNAME} -s /bin/bash -h ${HOME_DIR} ${USERNAME} && \
    chown -R ${USERNAME}:${USERNAME} ${HOME_DIR}

# Copy NVM from base (contains node + npm)
COPY --from=base --chown=root:root /usr/local/nvm /usr/local/nvm

# Copy toolchains from builder stages into /usr/local/
COPY --from=branch-rust --chown=root:root /staging/usr/local/bin /usr/local/bin
COPY --from=branch-go --chown=root:root /staging/usr/local/go /usr/local/go
COPY --from=branch-go --chown=root:root /staging/usr/local/go-workspace /usr/local/go-workspace
COPY --from=branch-python --chown=root:root /staging/usr/local/bin/uv /usr/local/bin/uv
COPY --from=branch-typescript --chown=root:root /staging/usr/local/npm-ts /usr/local/npm-ts
COPY --from=branch-python --chown=root:root /staging/usr/local/npm-python /usr/local/npm-python
COPY --from=branch-claude --chown=root:root /staging/usr/local/bin/claude /usr/local/bin/claude

# Copy openspec globally installed npm package
COPY --from=branch-claude --chown=root:root /usr/local/nvm/versions/node /usr/local/nvm/versions/node

ARG NVM_VERSION="0.39.7"
ARG NODE_VERSION="20.12.2"
ENV NVM_DIR="/usr/local/nvm"
ENV GOPATH="/usr/local/go-workspace"
ENV PATH="$NVM_DIR/versions/node/v$NODE_VERSION/bin:$PATH:/usr/local/go/bin:/usr/local/go-workspace/bin:/usr/local/npm-ts/bin:/usr/local/npm-python/bin:/usr/local/bin"

# CLAUDE PLUGINS — currently none installed.
# See temp/next-changes.md "Configurable Claude Plugin Management" for
# the design to make plugin selection a sandbox.toml concern.

ENV SHELL=/bin/bash
ENV EDITOR=/usr/bin/nano
ENV VISUAL=/usr/bin/nano

# sshd requires root for L1 UID separation (setuid(agent) per session)
USER root

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]