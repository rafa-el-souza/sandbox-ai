
# 1. Internal-name boundary
# Return NXDOMAIN for internal cluster names so they never resolve to
# or leak toward the public internet.
cluster.local local internal {
    template ANY ANY . {
        rcode NXDOMAIN
    }
}

# 2. Whitelisted Domains Upstream (DNS-over-TLS Enforced)
# Standard CoreDNS distributions lack dynamic `dstdomain "/file"` reading.
# Ensure no leading wildcards in the allow list.
{{ proxy_whitelist_domains_coredns | join(' ') }} {
    log # Log successful queries (visible via `sandbox-cli logs`)
    
    # Suppress AAAA (IPv6) answers
    # Return empty NOERROR for AAAA so clients fall back to IPv4 only.
    template ANY AAAA {
        rcode NOERROR
    }
    
    # DNS-over-TLS upstream (avoids SSL MITM per the OpenSpec mandate).
    # KEY DECISION: uses Mullvad's "all" blocklist resolver, which filters
    # ads, trackers, malware, and gambling at the resolver.
    forward . tls://194.242.2.9 {
        tls_servername all.dns.mullvad.net
        health_check 5s
    }
    cache 30
}

# 3. NXDOMAIN catch-all (blocks unlisted lookups / DNS tunneling)
# Any name not matched above resolves to NXDOMAIN here.
. {
    log # Log unmatched queries for auditing
    
    # KEY DECISION: bind the HTTP health check to the 127.0.0.1 loopback only,
    # so it is not reachable from the Agent proxy interface or other containers.
    health 127.0.0.1:8080
    
    template ANY ANY . {
        rcode NXDOMAIN
    }
}