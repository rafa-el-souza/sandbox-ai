# Per-instance sandbox state (generated at runtime)
sandboxes/*/
.state/

# Secrets — never commit
.sandbox.env
*.htpasswd
sandbox-ai.toml

# Legacy / deprecated
.deprecated/
temp/

# Maintainer-internal spec-workflow state — backlog, ongoing explorations,
# validation records, findings, transcripts (only openspec/specs/ is published)
openspec/explorations/
openspec/changes/
openspec/schemas/

# Tooling
# Containerized-gate HOME (uv and pyright caches inside no-mistakes runs;
# see .no-mistakes.yaml for why HOME is redirected here)
.nm-home/
# no-mistakes tooling output (validation evidence, run artifacts) — never tracked
.no-mistakes/
.antigravityignore
.agent/
.venv/
.claude/
.claudeignore

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

dist/
scripts/integration-probe.sh
docs/assets/
_bmad-output/
_bmad/
